{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delegauth.com/spec/0.1/delegauth-v0.1.schema.json",
  "title": "Delegauth Policy Schema v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "delegauth_version",
    "mandate_id",
    "generated_at_utc",
    "policy_hash",
    "locale",
    "identity",
    "action_scope",
    "financial_limits",
    "dynamic_limits",
    "overflow_handling",
    "integrity_safeguards",
    "audit_requirements",
    "state_management"
  ],
  "properties": {
    "delegauth_version": { "type": "string", "const": "0.1" },
    "mandate_id": { "type": "string", "minLength": 8 },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "policy_hash": { "type": "string", "minLength": 16 },
    "locale": { "type": "string", "enum": ["en", "de"] },

    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_name",
        "entity_type",
        "organization",
        "responsible_authority",
        "effective_date"
      ],
      "properties": {
        "entity_name": { "type": "string", "minLength": 1 },
        "entity_type": { "type": "string", "minLength": 1 },
        "organization": { "type": "string", "minLength": 1 },
        "responsible_authority": { "type": "string", "minLength": 1 },
        "effective_date": { "type": "string", "format": "date" }
      }
    },

    "action_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_actions", "restricted_actions"],
      "properties": {
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "restricted_actions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },

    "financial_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_refund_per_ticket", "currency"],
      "properties": {
        "max_refund_per_ticket": { "type": "number", "exclusiveMinimum": 0 },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 }
      }
    },

    "dynamic_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "business_timezone",
        "reset_time_local",
        "max_refunds_per_business_day",
        "max_total_refund_per_business_day"
      ],
      "properties": {
        "business_timezone": { "type": "string", "pattern": ".+/.+" },
        "reset_time_local": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" },

        "max_refunds_per_business_day": { "type": "integer", "minimum": 0 },
        "max_total_refund_per_business_day": { "type": "number", "minimum": 0 },

        "max_refunds_per_customer_per_business_day": { "type": "integer", "minimum": 0 },
        "max_total_refund_per_customer_per_business_day": { "type": "number", "minimum": 0 }
      }
    },

    "overflow_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limits_overflow_state",
        "paused_disallowed_actions",
        "notify_role",
        "require_human_review"
      ],
      "properties": {
        "limits_overflow_state": { "type": "string", "const": "PAUSED" },
        "paused_disallowed_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "notify_role": { "type": "string", "minLength": 1 },
        "require_human_review": { "type": "boolean", "const": true }
      }
    },

    "integrity_safeguards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "suspend_triggers"],
      "properties": {
        "enabled": { "type": "boolean" },
        "suspend_triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "AUDIT_WRITE_FAILED",
              "LIMIT_EVALUATION_UNCERTAIN_REPEATED",
              "RESTRICTED_ACTION_ATTEMPTED",
              "POLICY_MISMATCH_OR_STALE",
              "DUPLICATE_EXECUTION_RISK"
            ]
          }
        }
      }
    },

    "audit_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["log_all_actions", "log_state_transitions", "log_limit_violations"],
      "properties": {
        "log_all_actions": { "type": "boolean", "const": true },
        "log_state_transitions": { "type": "boolean", "const": true },
        "log_limit_violations": { "type": "boolean", "const": true }
      }
    },

    "state_management": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_state"],
      "properties": {
        "current_state": { "type": "string", "enum": ["ACTIVE", "PAUSED", "SUSPENDED", "TERMINATED"] }
      }
    }
  }
}
